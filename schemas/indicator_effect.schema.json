{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "indicator_effect.schema.json",
  "title": "IndicatorEffect",
  "description": "Maskinläsbar effektbedömning som aggregerar flera claims för (parti, kategori, indikator).",
  "type": "object",
  "additionalProperties": false,
  "required": ["party", "category", "indicator", "expected_direction", "net_support", "confidence"],
  "properties": {
    "party": { "type": "string" },
    "category": { "type": "string" },
    "indicator": { "type": "string" },
    "expected_direction": { "type": "string", "enum": ["up", "down", "target"] },
    "net_support": { "type": "number", "minimum": -1, "maximum": 1, "description": "Nettostöd: >0 stödjer positiv riktning, <0 motsäger." },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "supporting_claims": { "type": "array", "items": { "type": "string" } },
    "contradicting_claims": { "type": "array", "items": { "type": "string" } }
  }
}
